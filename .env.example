# ==========================================
# 知味生活 · SavoryLife 环境变量示例
# 复制为 .env 并填入真实值后，通过 IDE / 启动脚本注入
# 切勿把真实密钥提交到 git
# ==========================================

# ---- MySQL（本地 docker，端口 3307）----
SAVORY_MYSQL_HOST=localhost
SAVORY_MYSQL_PORT=3307
SAVORY_MYSQL_USERNAME=root
SAVORY_MYSQL_PASSWORD=root123

# ---- Redis / MongoDB ----
SAVORY_REDIS_HOST=localhost
SAVORY_REDIS_PORT=6380
SAVORY_REDIS_PASSWORD=
SAVORY_REDIS_DATABASE=0
SAVORY_MONGODB_HOST=localhost

# ---- PostgreSQL + pgvector ----
SAVORY_PGVECTOR_HOST=localhost
SAVORY_PGVECTOR_PASSWORD=postgres

# ---- RocketMQ ----
SAVORY_ROCKETMQ_NAME_SERVER=localhost:9876

# ---- JWT（生产必须替换为强随机 Base64 密钥）----
JWT_ADMIN_SECRET=
JWT_USER_SECRET=

# ---- AI（DeepSeek chat + 硅基流动 embedding）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
AI_SERVICE_URL=http://localhost:8087

# ---- 微信 / 阿里云 OSS / 百度地图 / 天气（按需配置）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
WECHAT_API_KEY=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
BAIDU_AK=
WEATHER_API_KEY=
